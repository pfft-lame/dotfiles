(defcfg
  process-unmapped-keys yes
  log-layer-changes no
  concurrent-tap-hold yes
)

(defsrc
  caps tab
  ; ' q
  lalt spc
)

(defvar
  tap-time 250
  hold-time 250
)

(defalias
  caps-mod (tap-hold 170 170 esc lctl)
  tab-mod (tap-hold $tap-time $hold-time tab lmet)
  ;-mod (tap-hold $tap-time $hold-time ; rmet)
  '-mod (tap-hold $tap-time $hold-time ' rctl)
  q-mod (tap-hold $tap-time $hold-time q lmet)
  lalt-mod (tap-hold $tap-time $hold-time caps lalt)
  spc-mod (tap-hold 300 300 spc lalt)
)

(deflayer base
  @caps-mod @tab-mod
  @;-mod @'-mod @q-mod
  @lalt-mod @spc-mod
)

